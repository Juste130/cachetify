# Serveur
NODE_ENV=development
PORT=
API_BASE_URL=
FRONTEND_URL=
# Nombre de reverse proxies devant l'app (1 = derriere un seul proxy, ex. Render/Heroku/nginx).
# Laisser vide = 1 par defaut. Mettre 0 seulement en acces direct sans proxy.
TRUST_PROXY=

# Base de donnees
DATABASE_URL=
DIRECT_URL=

# Securite / chiffrement
MASTER_ENCRYPTION_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Blockchain / RPC
ALCHEMY_API_KEY=
ALCHEMY_POLYGON_RPC_URL=
ALCHEMY_POLYGON_TESTNET_RPC_URL=
POLYGON_RPC_URL=
POLYGON_TESTNET_RPC_URL=
CONTRACT_MANAGER_ADDRESS=
CONTRACT_NFT_ADDRESS=
# Base URI baked into ContractNFT.sol at deploy time (tokenURI() = this + the token id) —
# must be this backend's own public URL + /api/nft/, trailing slash included. Only read by
# blockchain/scripts/deploy.ts, not by the server itself; can be changed later without a
# redeploy via ContractNFT.setBaseTokenURI(). Example: https://api.cachetify.io/api/nft/
NFT_METADATA_BASE_URI=
ADMIN_WALLET_ADDRESS=
POLLING_INTERVAL_MS=
ENABLE_RPC_MONITORING=
RPC_MONITORING_THRESHOLD_PER_HOUR=
INITIAL_GAS_AMOUNT=

# Stockage IPFS (Pinata)
PINATA_JWT=
# La passerelle publique partagee (gateway.pinata.cloud, valeur par defaut si vide) refuse de
# servir du contenu text/html "pour des raisons de securite" (anti-phishing) — exactement le
# cas des contrats generes par IA, uploades en HTML pour s'ouvrir comme un document mis en
# forme. Utiliser la passerelle dediee de votre compte Pinata (tableau de bord Pinata >
# Gateways, ex: https://votre-sous-domaine.mypinata.cloud) leve cette restriction, sans
# changement de code : c'est le meme format d'URL (<gateway>/ipfs/<cid>). Doit correspondre a
# NEXT_PUBLIC_IPFS_GATEWAY cote frontend (frontend/.env.example) — deux valeurs differentes
# donnent des liens qui marchent depuis le backend mais pas depuis l'app, ou l'inverse.
PINATA_GATEWAY=

# Verification d'identite (KYC) — Smile ID (couvre Benin/Togo/Cote d'Ivoire/Senegal avec une
# seule integration). Laisser vide = mode simulation (KYC_MOCK_MODE reste a "true" par
# defaut) : les soumissions sont approuvees automatiquement apres quelques secondes, sans
# appeler la vraie API — utile pour construire/demontrer le produit avant que le compte
# partenaire Smile ID soit finalise. Mettre KYC_MOCK_MODE=false une fois les identifiants
# ci-dessous renseignes pour de vrai.
KYC_MOCK_MODE=
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
# '0' = bac a sable, '1' = production
SMILE_ID_SERVER=0
SMILE_ID_CALLBACK_URL=

# Ramp (on/off-ramp fiat)
RAMP_API_KEY=
RAMP_WEBHOOK_SECRET=
RAMP_HOST_API_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_AI_MAX_REQUESTS=
RATE_LIMIT_WALLET_MAX_REQUESTS=
RATE_LIMIT_INVITE_MAX_REQUESTS=

# Logs
LOG_LEVEL=
LOG_FILE_PATH=

# IA
GROQ_API_KEY=
# Modèle gratuit Groq (voir https://console.groq.com/docs/rate-limits pour la liste à jour)
GROQ_MODEL=openai/gpt-oss-120b

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Paiements (séquestre fiat, hors blockchain) — aucun agrégateur n'est encore branché.
# Laisser à false tant que backend/services/payments n'a pas d'implémentation réelle.
PAYMENTS_ENABLED=false
# Fréquence (ms) à laquelle le planificateur de séquestre vérifie les rappels/libérations dues
ESCROW_SCHEDULER_INTERVAL_MS=900000

# Divers
ADMIN_EMAILS=
BD_PASSWORD=
