        "@types/jsonwebtoken": "^9.0.7",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.10.2",
        "@types/nodemailer": "^6.4.17",
        "eslint": "^9.17.0",
        "jest": "^29.6.1",
        "nodemon": "^3.1.9",
        "prisma": "^5.22.0"
