{
    "name": "cachetify-backend",
    "version": "1.0.0",
    "description": "Backend API for Cachetify - Hybrid blockchain contract management platform",
    "main": "server.js",
    "scripts": {
        "dev": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first nodemon server.js",
        "start": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first node server.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "test": "jest --passWithNoTests",
        "lint": "eslint **/*.js"
    },
    "keywords": [
        "blockchain",
        "contracts",
        "ethereum",
        "ai",
        "ipfs"
    ],
    "author": "Sènami Juste HOUEZO",
    "license": "MIT",
