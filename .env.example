# Serveur
NODE_ENV=development
# URL publique de l'app elle-meme (liens dans les e-mails, construction d'URL de callback).
# Une seule app desormais : plus de distinction API_BASE_URL/FRONTEND_URL separees.
FRONTEND_URL=

# Base de donnees
DATABASE_URL=
DIRECT_URL=

# Securite / chiffrement
MASTER_ENCRYPTION_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Blockchain / RPC
ALCHEMY_API_KEY=
ALCHEMY_POLYGON_RPC_URL=
ALCHEMY_POLYGON_TESTNET_RPC_URL=
POLYGON_RPC_URL=
POLYGON_TESTNET_RPC_URL=
CONTRACT_MANAGER_ADDRESS=
ADMIN_WALLET_ADDRESS=

# Adresse du smart contract deploye (Polygon) — cote client, meme adresse que
# CONTRACT_MANAGER_ADDRESS ci-dessus (une seule app desormais, une seule verite).
NEXT_PUBLIC_CONTRACT_MANAGER_ADDRESS=

# RPC public du reseau de test Polygon Amoy, utilise UNIQUEMENT par la page publique de
# verification (/verify/[token]) pour relire l'empreinte et les signatures directement sur la
# blockchain, depuis le navigateur, sans passer par notre serveur (voir memoire, chapitre 3,
# section Reponse a la problematique). Vide = RPC public officiel par defaut, suffisant pour
# ce seul usage en lecture.
NEXT_PUBLIC_POLYGON_RPC_URL=

# Stockage IPFS (Pinata)
PINATA_JWT=
# La passerelle publique partagee (gateway.pinata.cloud, valeur par defaut si vide) refuse de
# servir du contenu text/html "pour des raisons de securite" (anti-phishing) — exactement le
# cas des contrats generes par IA, uploades en HTML pour s'ouvrir comme un document mis en
# forme. Utiliser la passerelle dediee de votre compte Pinata (tableau de bord Pinata >
# Gateways, ex: https://votre-sous-domaine.mypinata.cloud) leve cette restriction, sans
# changement de code : c'est le meme format d'URL (<gateway>/ipfs/<cid>).
PINATA_GATEWAY=

# Verification d'identite (KYC) — Smile ID (couvre Benin/Togo/Cote d'Ivoire/Senegal avec une
# seule integration). Laisser vide = mode simulation (KYC_MOCK_MODE reste a "true" par
# defaut) : les soumissions sont approuvees automatiquement apres quelques secondes, sans
# appeler la vraie API — utile pour construire/demontrer le produit avant que le compte
# partenaire Smile ID soit finalise. Mettre KYC_MOCK_MODE=false une fois les identifiants
# ci-dessous renseignes pour de vrai.
KYC_MOCK_MODE=
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
# '0' = bac a sable, '1' = production
SMILE_ID_SERVER=0
SMILE_ID_CALLBACK_URL=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Rate limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_AI_MAX_REQUESTS=
RATE_LIMIT_WALLET_MAX_REQUESTS=
RATE_LIMIT_INVITE_MAX_REQUESTS=

# Logs
LOG_LEVEL=
LOG_FILE_PATH=

# IA
GROQ_API_KEY=
# Modèle gratuit Groq (voir https://console.groq.com/docs/rate-limits pour la liste à jour)
GROQ_MODEL=openai/gpt-oss-120b

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# Paiements (séquestre fiat, hors blockchain) — aucun agrégateur n'est encore branché.
# Laisser à false tant que src/server/services/payments n'a pas d'implémentation réelle.
PAYMENTS_ENABLED=false

# Sequestre hors perimetre du memoire : masque (routes ET interface) tant que ces deux
# variables ne valent pas exactement "true". Next.js n'expose au client que ce qui est
# prefixe NEXT_PUBLIC_, donc les deux lignes restent necessaires meme dans une seule app —
# mais c'est desormais un seul fichier .env a garder coherent, plus deux deploiements separes.
FEATURE_ESCROW=
NEXT_PUBLIC_FEATURE_ESCROW=

# Divers
ADMIN_EMAILS=
