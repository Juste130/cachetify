# URL de l'API backend
NEXT_PUBLIC_API_URL=

# Adresse du smart contract deploye (Polygon)
NEXT_PUBLIC_CONTRACT_MANAGER_ADDRESS=

# Privy (authentification)
NEXT_PUBLIC_PRIVY_APP_ID=

# Sequestre hors perimetre du memoire : masque dans l'interface tant que cette variable ne
# vaut pas exactement "true". Doit rester alignee avec l'equivalent cote serveur
# (FEATURE_ESCROW dans backend/.env) : l'activer seulement ici affiche une interface dont les
# appels API echoueront. Le KYC, lui, reste toujours actif et n'a pas d'equivalent ici — voir
# frontend/src/lib/features.ts.
NEXT_PUBLIC_FEATURE_ESCROW=

# RPC public du reseau de test Polygon Amoy, utilise UNIQUEMENT par la page publique de
# verification (/verify/[token]) pour relire l'empreinte et les signatures directement sur la
# blockchain, depuis le navigateur, sans passer par notre serveur (voir memoire, chapitre 3,
# section Reponse a la problematique). Vide = RPC public officiel par defaut, suffisant pour
# ce seul usage en lecture.
NEXT_PUBLIC_POLYGON_RPC_URL=
