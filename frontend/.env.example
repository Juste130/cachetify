# URL de l'API backend
NEXT_PUBLIC_API_URL=

# Adresses des smart contracts deployes (Polygon)
NEXT_PUBLIC_CONTRACT_MANAGER_ADDRESS=
NEXT_PUBLIC_CONTRACT_NFT_ADDRESS=

# Privy (authentification)
NEXT_PUBLIC_PRIVY_APP_ID=

# Fonctionnalites hors perimetre du memoire (sequestre, NFT) : masquees dans l'interface tant
# que ces variables ne valent pas exactement "true". Doivent rester alignees avec les
# equivalents cote serveur (FEATURE_ESCROW, FEATURE_NFT dans backend/.env) : activer l'un sans
# l'autre affiche une interface dont les appels API echoueront. Le KYC, lui, reste toujours
# actif et n'a pas d'equivalent ici — voir frontend/src/lib/features.ts.
NEXT_PUBLIC_FEATURE_ESCROW=
NEXT_PUBLIC_FEATURE_NFT=

# RPC public du reseau de test Polygon Amoy, utilise UNIQUEMENT par la page publique de
# verification (/verify/[token]) pour relire l'empreinte et les signatures directement sur la
# blockchain, depuis le navigateur, sans passer par notre serveur (voir memoire, chapitre 3,
# section Reponse a la problematique). Vide = RPC public officiel par defaut, suffisant pour
# ce seul usage en lecture.
NEXT_PUBLIC_POLYGON_RPC_URL=
